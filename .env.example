# Fieldnote billing slice: environment variables.
# Copy this file to .env.local (git-ignored) and fill in the values:   cp .env.example .env.local
# Never put real keys in this file. It is committed; .env.local is not.

# --- Required ---------------------------------------------------------------

# Flutterwave TEST-mode secret key. Starts with FLWSECK_TEST- (the app refuses live keys).
# From: Flutterwave dashboard, Test mode on -> Settings -> API Keys -> Secret key.
# Left empty here on purpose: until it's set, Pay shows "FLW_SECRET_KEY is not set".
FLW_SECRET_KEY=

# SQLite database file, relative to the project root. Created by `npm run db:deploy`.
DATABASE_URL="file:./data/fieldnote.db"

# --- Defaults that work locally as they are --------------------------------

# Where Flutterwave sends the customer back after checkout. Your local URL, or your tunnel's
# https URL if you're receiving webhooks.
APP_URL=http://localhost:3000

# The single built-in user (there is no sign-in). Any name and email will do.
DEMO_USER_NAME=Demo User
DEMO_USER_EMAIL=demo.user@example.com

# --- Optional ---------------------------------------------------------------

# Webhooks. A long random string you make up, e.g. `openssl rand -base64 32`, and paste the same
# value into Flutterwave dashboard -> Settings -> Webhooks -> Secret hash.
# Unset = the webhook endpoint refuses every request (payments still confirm on the return page).
FLW_WEBHOOK_SECRET_HASH=

# Scheduled billing run: POST /api/billing/run with "Authorization: Bearer <CRON_SECRET>".
# A long random string you make up. Unset = that endpoint is disabled (Test tools still work).
# CRON_SECRET=

# Return URL for saved-card charges if the bank asks the customer to authenticate.
# Flutterwave needs public https here; defaults to APP_URL/billing when APP_URL is public https.
# FLW_CHARGE_REDIRECT_URL=https://your-tunnel.trycloudflare.com/billing

# Test tools (reset, skip to period end) are on in development. Set to true to allow them
# in a production build too.
# ENABLE_DEMO_RESET=false
